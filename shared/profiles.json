{
  "_comment": "坐标/单位/轴向换算档案。每对 (源->目标) 一条。数值均为默认值，首次接入新版本软件请用 tools/calibrate.py 跑一次自检后覆盖。",
  "schema": 1,

  "apps": {
    "blender": {
      "display": "Blender",
      "up_axis": "Z",
      "forward_axis": "-Y",
      "unit": "m",
      "unit_to_cm": 100.0,
      "handedness": "right",
      "script_lang": "python",
      "formats": ["fbx", "usd", "gltf", "obj"]
    },
    "unreal": {
      "display": "Unreal Engine",
      "up_axis": "Z",
      "forward_axis": "X",
      "unit": "cm",
      "unit_to_cm": 1.0,
      "handedness": "left",
      "script_lang": "python",
      "formats": ["fbx", "usd", "obj", "abc"]
    },
    "maya": {
      "display": "Maya",
      "up_axis": "Y",
      "forward_axis": "Z",
      "unit": "cm",
      "unit_to_cm": 1.0,
      "handedness": "right",
      "script_lang": "python",
      "formats": ["fbx", "usd", "obj", "ma", "abc"]
    },
    "substance_painter": {
      "display": "Substance 3D Painter",
      "up_axis": "Y",
      "forward_axis": "Z",
      "unit": "cm",
      "unit_to_cm": 1.0,
      "handedness": "right",
      "script_lang": "javascript-qml",
      "formats": ["fbx", "obj", "usd"],
      "note": "SP 主要做「接收模型 / 回传贴图」，收发模型是次要路径"
    },
    "toolbag": {
      "display": "Marmoset Toolbag",
      "up_axis": "Y",
      "forward_axis": "Z",
      "unit": "m",
      "unit_to_cm": 100.0,
      "handedness": "right",
      "script_lang": "python",
      "formats": ["fbx", "obj", "usd", "abc"],
      "note": "Toolbag 5 内嵌 Python（模块名 mset）。烘焙/渲染两种模式，见 routes.*>toolbag.options.mode"
    },
    "photoshop": {
      "display": "Adobe Photoshop",
      "up_axis": "-",
      "forward_axis": "-",
      "unit": "px",
      "unit_to_cm": 1.0,
      "handedness": "right",
      "script_lang": "none",
      "formats": ["png", "psd", "tga", "jpg", "jpeg", "bmp", "exr", "tif"],
      "note": "无应用内适配器：由 tools/editor_daemon.py 外部守护进程代管（打开文件 + 监听保存回传）"
    },
    "sai2": {
      "display": "SAI2",
      "up_axis": "-",
      "forward_axis": "-",
      "unit": "px",
      "unit_to_cm": 1.0,
      "handedness": "right",
      "script_lang": "none",
      "formats": ["png", "psd", "bmp", "jpg", "jpeg", "tif"],
      "note": "同 Photoshop：外部守护进程代管；SAI2 默认存 .sai2，回传需另存为 PNG/PSD"
    },
    "zbrush": {
      "display": "ZBrush",
      "up_axis": "?",
      "forward_axis": "?",
      "unit": "generic",
      "unit_to_cm": 1.0,
      "handedness": "?",
      "script_lang": "python",
      "formats": ["obj"],
      "note": "2026.1+ 官方 Python SDK（zbrush.commands，仅主线程可调）。OBJ 不带单位，ZBrush 导入时归一化到约 2 单位并把还原系数记在 Tool>Export，导出按该系数还原为进入前数值，故 global_scale=1.0 透传（2026-10-13 1m 立方往返实测）。轴向/手性待带朝向模型实测（?）"
    }
  },

  "routes": {
    "blender>unreal": {
      "format": "fbx",
      "export": {
        "global_scale": 1.0,
        "apply_unit_scale": true,
        "use_space_transform": true,
        "bake_space_transform": false,
        "add_leaf_bones": false,
        "primary_bone_axis": "Y",
        "secondary_bone_axis": "X",
        "path_mode": "COPY",
        "embed_textures": true
      },
      "import": {
        "_target": "unreal.FbxImportUI",
        "convert_scene": true,
        "convert_scene_unit": true,
        "force_front_x_axis": false,
        "import_uniform_scale": 1.0,
        "combine_meshes": false,
        "import_materials": true,
        "import_textures": true,
        "normal_import_method": "FBXNIM_IMPORT_NORMALS_AND_TANGENTS"
      },
      "_why": "两端都是 Z-up，无需换轴；米->厘米交给 UE 的 Convert Scene Unit 处理，因此导出端保持 1.0。"
    },

    "unreal>blender": {
      "format": "fbx",
      "export": {
        "_note": "UE 用 EditorAssetLibrary.export_asset 或 Content Browser 的 Asset -> Export，FBX 以 cm 写出",
        "ascii": false
      },
      "import": {
        "_target": "bpy.ops.import_scene.fbx",
        "global_scale": 1.0,
        "use_manual_orientation": false,
        "automatic_bone_orientation": true,
        "use_prepost_rot": true
      },
      "_why": "Blender 5.0 的 FBX 导入器已内建 cm->m 换算，接收端必须是 1.0。实测（2026-09-24，Blender 5.0.1 + UE 5.8.3）：同一 UE 导出的 FBX，global_scale=1.0 -> 2.0m（正确）；0.01 -> 0.02m（缩小 100 倍，错）；100 -> 200m（错）。旧值 0.01 是基于老版本 Blender 的错误假设，已修正。",
      "_measured": {
        "date": "2026-09-24",
        "blender": "5.0.1",
        "unreal": "5.8.3",
        "probe": {"1.0": "2.0m 正确", "0.01": "0.02m 错", "100": "200m 错"}
      }
    },

    "maya>unreal": {
      "format": "fbx",
      "export": {
        "_target": "FBXExport / file -type FBX",
        "up_axis": "y",
        "units": "cm",
        "scale_factor": 1.0
      },
      "import": {
        "_target": "unreal.FbxImportUI",
        "convert_scene": true,
        "convert_scene_unit": false,
        "force_front_x_axis": false,
        "import_uniform_scale": 1.0
      },
      "_why": "Maya 与 UE 同为 cm，无需缩放；Y-up -> Z-up 交给 UE 的 Convert Scene 处理。"
    },

    "unreal>maya": {
      "format": "fbx",
      "export": {"units": "cm"},
      "import": {"up_axis": "y", "scale_factor": 1.0},
      "_why": "同 cm，只需在 Maya 侧把导入 Up Axis 设回 Y。"
    },

    "blender>maya": {
      "format": "fbx",
      "export": {
        "global_scale": 1.0,
        "apply_unit_scale": true,
        "use_space_transform": true
      },
      "import": {
        "_target": "file -import / FBXImport",
        "up_axis": "y",
        "scale_factor": 1.0
      },
      "_why": "Blender 5.0 导出的 FBX 有效单位已是 cm，Maya 也是 cm，所以 scale 保持 1.0，只需在 Maya 侧把导入 Up Axis 设回 Y。实测（Maya 2023）：1m 立方体导入后为 100cm，往返无损。",
      "_measured": {"date": "2026-09-24", "blender": "5.0.1", "maya": "2023"}
    },

    "blender>substance_painter": {
      "format": "fbx",
      "export": {
        "global_scale": 1.0,
        "apply_unit_scale": true,
        "axis_forward": "-Z",
        "axis_up": "Y"
      },
      "import": {"convert_to_y_up": true},
      "_why": "SP 是 Y-up / cm，但 Blender 5.0 导出的 FBX 有效单位已是 cm，所以 global_scale 保持 1.0（实测用 100.0 会放大 100 倍）。只需把 Z-up 转成 Y-up。",
      "_status": "SP 侧尚未实机验证"
    },

    "substance_painter>unreal": {
      "format": "textures",
      "kind": "textures",
      "_note": "回传的是贴图而非模型：baseColor/normal/ORM 等，走同一条 transfer 通道，kind=textures"
    },

    "blender>toolbag": {
      "format": "fbx",
      "export": {
        "global_scale": 1.0,
        "apply_unit_scale": true,
        "use_space_transform": true,
        "axis_forward": "-Z",
        "axis_up": "Y"
      },
      "import": {"scene_unit_scale": 1.0},
      "options": {"mode": "bake"},
      "_why": "Toolbag 是 m 单位 / Y-up。Blender 5.0 导出的 FBX 有效单位已是 cm，Toolbag 导入时按 0.01 换算回 m，故 global_scale 保持 1.0。options.mode 由发送端 UI 选择：bake=烘焙（建烘焙组+高低模），render=仅导入。"
    },

    "maya>toolbag": {
      "format": "fbx",
      "export": {"up_axis": "y", "units": "cm", "scale_factor": 1.0},
      "import": {"scene_unit_scale": 1.0},
      "options": {"mode": "bake"},
      "_why": "Maya cm / Y-up，与 Toolbag 只差单位制，FBX 内为 cm，Toolbag 侧按 0.01 换算。"
    },

    "unreal>toolbag": {
      "format": "fbx",
      "export": {"ascii": false},
      "import": {"scene_unit_scale": 1.0},
      "options": {"mode": "bake"},
      "_why": "UE cm / Z-up，FBX 带 Convert Scene 处理换轴；单位同样走 Toolbag 侧 0.01 换算。"
    },

    "toolbag>substance_painter": {
      "format": "textures",
      "kind": "textures",
      "_note": "Toolbag 只回传烘焙贴图（烘焙完成后自动发一条 kind=textures 给 SP）。SP 侧作为工程资源导入。"
    },

    "blender>photoshop": {
      "format": "textures",
      "kind": "textures",
      "_note": "只发贴图。PS 由外部守护进程打开；保存后守护进程回传一条 kind=textures 给发送端（options.return_of 指向原 transfer），发送端自动重载。"
    },
    "maya>photoshop": {"format": "textures", "kind": "textures", "_note": "同 blender>photoshop"},
    "unreal>photoshop": {"format": "textures", "kind": "textures", "_note": "同 blender>photoshop"},
    "substance_painter>photoshop": {"format": "textures", "kind": "textures", "_note": "同 blender>photoshop"},

    "blender>sai2": {"format": "textures", "kind": "textures", "_note": "同 blender>photoshop"},
    "maya>sai2": {"format": "textures", "kind": "textures", "_note": "同 blender>photoshop"},
    "unreal>sai2": {"format": "textures", "kind": "textures", "_note": "同 blender>photoshop"},
    "substance_painter>sai2": {"format": "textures", "kind": "textures", "_note": "同 blender>photoshop"},

    "photoshop>blender": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道（发送端自动重载）"},
    "photoshop>maya": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道"},
    "photoshop>unreal": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道"},
    "photoshop>substance_painter": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道"},
    "sai2>blender": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道（发送端自动重载）"},
    "sai2>maya": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道"},
    "sai2>unreal": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道"},
    "sai2>substance_painter": {"format": "textures", "kind": "textures", "_note": "守护进程回传通道"},

    "zbrush>blender": {"format": "obj", "kind": "models", "export": {"global_scale": 1.0}, "import": {"global_scale": 1.0}, "_note": "OBJ 不带单位；ZBrush 导出按导入时记录的 Scale/Offset 还原为原始数值，1:1 透传（1m 立方往返实测）"},
    "blender>zbrush": {"format": "obj", "kind": "models", "export": {"global_scale": 1.0}, "import": {"global_scale": 1.0}, "_note": "ZBrush 导入 OBJ 自动归一化到约 2 单位（Tool>Export 记还原系数）；适配器导入前确保无活动 Polymesh，避免按错误系数缩放"},
    "zbrush>unreal": {"format": "obj", "kind": "models", "export": {"global_scale": 1.0}, "import": {"global_scale": 1.0, "import_uniform_scale": 100.0}, "_note": "OBJ 数值按米导入 UE 时乘 100（UE 单位 cm）；待实测校准"},
    "unreal>zbrush": {"format": "obj", "kind": "models", "export": {"global_scale": 0.01}, "import": {"global_scale": 1.0}, "_note": "UE 导出 cm→OBJ 数值按米；待实测校准"},
    "zbrush>maya": {"format": "obj", "kind": "models", "export": {"global_scale": 1.0}, "import": {"global_scale": 1.0, "scale_factor": 1.0}, "_note": "Maya 默认 cm，OBJ 数值 1:1；待实测校准"},
    "maya>zbrush": {"format": "obj", "kind": "models", "export": {"global_scale": 1.0}, "import": {"global_scale": 1.0}, "_note": "同 blender>zbrush"},
    "zbrush>substance_painter": {"format": "obj", "kind": "models", "export": {"global_scale": 1.0}, "import": {"global_scale": 1.0}, "_note": "SP 导入 OBJ；待实测校准"},
    "zbrush>toolbag": {"format": "obj", "kind": "models", "export": {"global_scale": 1.0}, "import": {"global_scale": 1.0}, "_note": "Toolbag 导入 OBJ；待实测校准"}
  },

  "naming": {
    "static_mesh": "SM_{name}",
    "skeletal_mesh": "SK_{name}",
    "skeleton": "SKEL_{name}",
    "texture": "T_{name}_{channel}",
    "material": "M_{name}",
    "material_instance": "MI_{name}"
  }
}
